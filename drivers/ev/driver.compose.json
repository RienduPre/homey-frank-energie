{
  "name": {
    "en": "Car or charger (Slim Laden)",
    "nl": "Auto of laadpaal (Slim Laden)"
  },
  "class": "sensor",
  "capabilities": [
    "frank_smart_charging",
    "frank_solar_charging",
    "measure_battery",
    "frank_ev_charging",
    "frank_ev_plugged_in",
    "measure_power",
    "frank_ev_range",
    "frank_ev_charge_limit",
    "frank_ev_max_charge_limit",
    "frank_ev_min_charge_limit",
    "frank_ev_ready_by",
    "frank_ev_time_remaining"
  ],
  "platforms": [
    "local"
  ],
  "connectivity": [
    "cloud"
  ],
  "images": {
    "small": "{{driverAssetsPath}}/images/small.png",
    "large": "{{driverAssetsPath}}/images/large.png",
    "xlarge": "{{driverAssetsPath}}/images/xlarge.png"
  },
  "pair": [
    {
      "id": "login_credentials",
      "template": "login_credentials",
      "options": {
        "usernameLabel": {
          "en": "E-mail address",
          "nl": "E-mailadres"
        },
        "usernamePlaceholder": {
          "en": "you@example.com",
          "nl": "jij@voorbeeld.nl"
        },
        "passwordLabel": {
          "en": "Password",
          "nl": "Wachtwoord"
        },
        "passwordPlaceholder": {
          "en": "Password",
          "nl": "Wachtwoord"
        }
      },
      "navigation": {
        "next": "list_devices"
      }
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "repair": [
    {
      "id": "login_credentials",
      "template": "login_credentials",
      "options": {
        "usernameLabel": {
          "en": "E-mail address",
          "nl": "E-mailadres"
        },
        "passwordLabel": {
          "en": "Password",
          "nl": "Wachtwoord"
        }
      }
    }
  ],
  "capabilitiesOptions": {
    "measure_power": {
      "title": {
        "en": "Charging power",
        "nl": "Laadvermogen"
      }
    }
  },
  "energy": {
    "batteries": [
      "INTERNAL"
    ]
  }
}
