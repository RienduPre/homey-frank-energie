{
  "name": {
    "en": "Solar panels (smart feed-in)",
    "nl": "Zonnepanelen (slim terugleveren)"
  },
  "class": "sensor",
  "capabilities": [
    "frank_pv_operational_status",
    "frank_pv_steering_status",
    "frank_pv_total_result",
    "frank_pv_total_bonus",
    "frank_smart_feed_in"
  ],
  "platforms": [
    "local"
  ],
  "connectivity": [
    "cloud"
  ],
  "images": {
    "small": "{{driverAssetsPath}}/images/small.png",
    "large": "{{driverAssetsPath}}/images/large.png",
    "xlarge": "{{driverAssetsPath}}/images/xlarge.png"
  },
  "pair": [
    {
      "id": "login_credentials",
      "template": "login_credentials",
      "options": {
        "usernameLabel": {
          "en": "E-mail address",
          "nl": "E-mailadres"
        },
        "usernamePlaceholder": {
          "en": "you@example.com",
          "nl": "jij@voorbeeld.nl"
        },
        "passwordLabel": {
          "en": "Password",
          "nl": "Wachtwoord"
        },
        "passwordPlaceholder": {
          "en": "Password",
          "nl": "Wachtwoord"
        }
      },
      "navigation": {
        "next": "list_devices"
      }
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "repair": [
    {
      "id": "login_credentials",
      "template": "login_credentials",
      "options": {
        "usernameLabel": {
          "en": "E-mail address",
          "nl": "E-mailadres"
        },
        "passwordLabel": {
          "en": "Password",
          "nl": "Wachtwoord"
        }
      }
    }
  ]
}
